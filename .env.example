# Never commit real credentials. This file is documentation only; the CLI reads process env vars.
COS_SECRET_ID=
COS_SECRET_KEY=
# Optional when using temporary Tencent Cloud credentials.
COS_SESSION_TOKEN=
COS_BUCKET=
COS_REGION=

MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net

# Local metadata store and safety/time limits.
DOCUMENT_DB_PATH=var/document_ingestion.sqlite3
DOCUMENT_MAX_BYTES=209715200
MINERU_ZIP_MAX_BYTES=524288000
MINERU_ZIP_MAX_UNCOMPRESSED_BYTES=1073741824
COS_SIGNED_URL_TTL_SECONDS=7200
HTTP_TIMEOUT_SECONDS=30

# Optional AGICTO semantic fallback for expense precheck. This credential is
# independent from COS, MinerU, and other model providers.
AGICTO_API_KEY=
AGICTO_TIMEOUT_SECONDS=120
